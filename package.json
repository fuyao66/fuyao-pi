{
  "name": "fuyao-pi",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Fuyao's personal Pi agent: first-party plugins, pinned companions, and portable configuration",
  "repository": { "type": "git", "url": "https://github.com/fuyao66/fuyao-pi.git" },
  "keywords": ["pi-package"],
  "pi": {
    "extensions": [
      "./packages/remote-ssh/dist/pi-extension.js",
      "./packages/advisor/index.ts",
      "./packages/memory/src/index.ts",
      "./packages/ui/extensions/header/index.ts",
      "./packages/ui/extensions/matrix/index.ts",
      "./packages/ui/extensions/zentui/index.ts",
      "./packages/ui/extensions/dual-quota/index.ts",
      "./packages/ui/extensions/claude-shimmer/index.ts"
    ],
    "skills": ["./skills"],
    "prompts": ["./prompts/*.md"],
    "themes": ["./packages/ui/themes/*.json", "./themes/*.json"]
  },
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "build": "bun packages/remote-ssh/scripts/build.ts",
    "build:pi": "bun run build",
    "build:pi-worker:arm64": "bun packages/remote-ssh/scripts/compile-pi-worker.ts arm64",
    "build:pi-worker:x64": "bun packages/remote-ssh/scripts/compile-pi-worker.ts x64",
    "build:pi-worker:all": "bun run build:pi-worker:arm64 && bun run build:pi-worker:x64",
    "smoke:pi": "bun packages/remote-ssh/scripts/smoke-fixed-stack.ts",
    "benchmark:pi": "bun packages/remote-ssh/scripts/benchmark-remote.ts pi",
    "check:ui": "node packages/ui/scripts/check.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/memory/tsconfig.json",
    "test:memory": "FUYAO_MEMORY_EMBEDDING_DISABLED=1 node --import tsx packages/memory/tests/self-test.test.ts && FUYAO_MEMORY_EMBEDDING_DISABLED=1 node --import tsx --test packages/memory/tests/hybrid.test.ts",
    "test": "bun test ./test ./packages/advisor/test ./packages/remote-ssh/test && bun run test:memory",
    "check": "bun run typecheck && bun run build && bun run check:ui && bun run test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "billion-context-pi": "0.1.82",
    "typescript": "^5.8.0"
  }
}
